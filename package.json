{
  "name": "blackboard",
  "version": "0.6.0",
  "description": "Infinite Blackboard：PoC / 内核 LPE 代码教学画布，项目制导入、Agent 逐行讲解、攻击链与宏查询。",
  "type": "module",
  "bin": {
    "blackboard": "./bin/blackboard.js",
    "flow": "./bin/flow.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "serve": "node bin/blackboard.js serve",
    "export": "node bin/blackboard.js export",
    "demo:teaching": "node scripts/demo-teaching.js",
    "board:start": "./scripts/board-start.sh",
    "board:stop": "./scripts/board-stop.sh",
    "board:status": "./scripts/board-status.sh",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --config desktop/electron-builder.yml --dir",
    "desktop:dist": "electron-builder --config desktop/electron-builder.yml"
  },
  "license": "MIT",
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "desktop/main.cjs",
  "author": "LxxxtSec"
}
