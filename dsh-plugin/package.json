{
  "name": "dsh-plugin-infinite-blackboard",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: infinite blackboard teaching canvas and native board tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LxxxtSec/infinite-blackboard.git"
  },
  "homepage": "https://github.com/LxxxtSec/infinite-blackboard#readme",
  "bugs": {
    "url": "https://github.com/LxxxtSec/infinite-blackboard/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "infinite-blackboard",
    "kernel",
    "teaching"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "clean:meta": "node scripts/strip-appledouble.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
